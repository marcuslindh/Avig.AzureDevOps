<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources: nuget.org only. Every dependency and analyzer is public, so the package
  builds the same on this machine and on a GitHub runner.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
