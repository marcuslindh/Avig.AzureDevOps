<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources. Everything comes from nuget.org except Medusa.Analyzers, which exists only in the
  local feed: the rules assume Medusa's types and have no business being in a public
  feed. The mapping ensures it is never fetched from anywhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="G:\LocalNugetRepo" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Medusa.Analyzers" />
    </packageSource>
  </packageSourceMapping>
</configuration>
