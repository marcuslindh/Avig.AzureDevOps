<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Deterministic build with embedded symbols and SourceLink, like Avig.Result. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      release.ps1 raises the version one step on every release, like an odometer where every
      digit runs 0-9: 1.0.9 -> 1.1.0, 1.9.9 -> 2.0.0. Nothing else changes it. A released version
      is never replaced: nuget.org refuses, and release.ps1 refuses a tag that already exists.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Avig.AzureDevOps</PackageId>
    <Version>1.0.2</Version>
    <Title>Avig.AzureDevOps</Title>
    <Description>Clients for the Azure DevOps REST API — pull requests, work items, builds and wiki — sign-in with a personal access token that the application supplies, throttling that honours Retry-After, and every call answering with a Result whose message is written to be shown as it is.</Description>
    <PackageTags>azure-devops;pull-requests;work-items;wiki;rest</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/marcuslindh/Avig.AzureDevOps</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcuslindh/Avig.AzureDevOps</RepositoryUrl>
    <PackageReleaseNotes>No exceptions inside the package either: every method checks its arguments and answers with ResultStatus.Invalid and a message saying what is missing, network errors and timeouts become ResultStatus.Unavailable, and failures keep their message and status on the way out. Every member is documented, with every parameter.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Result<T> is part of the public surface, so Avig.Result is a real dependency. -->
    <PackageReference Include="Avig.Result" Version="1.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Avig.AzureDevOps.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- One README, two jobs: the Git host renders it at the root, NuGet inside the package. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
